# Environment Configuration Example
# Copy to .env and populate keys. Never commit .env or secrets to source control.

# Application Environment & Runtime Profile
APP_ENV=
APP_PROFILE=
APP_HOST=
APP_PORT=
LOG_LEVEL=

# Security & Sessions
SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
CORS_ORIGINS=

# Database (PostgreSQL with pgvector)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_APP_USER=
DB_APP_PASSWORD=
DB_RETRIEVER_USER=
DB_RETRIEVER_PASSWORD=
DATABASE_URL=
DATABASE_READONLY_URL=
TEST_USER_PASSWORD_HASH=


# Model Adapters & Provider Endpoints
OLLAMA_BASE_URL=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# Storage Backend
STORAGE_BACKEND=
LOCAL_STORAGE_PATH=
GCS_STORAGE_BUCKET=

# Task Queue (Procrastinate)
QUEUE_BACKEND=

# Observability & Local Tracing
LANGSMITH_TRACING=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
